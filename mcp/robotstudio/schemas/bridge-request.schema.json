{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/robotstudio-mcp/bridge-request.schema.json",
  "title": "RobotStudio MCP bridge request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "token", "method", "params", "timeout_ms", "client"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "token": { "type": "string", "minLength": 32 },
    "method": { "type": "string", "minLength": 1, "maxLength": 128 },
    "params": { "type": "object" },
    "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "client": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
