ROBOTSTUDIO_MCP_WORKSPACE=C:\Users\User\Documents\RobotStudioMCP\workspace
ROBOTSTUDIO_MCP_BRIDGE_HOST=127.0.0.1
ROBOTSTUDIO_MCP_BRIDGE_PORT=47625
ROBOTSTUDIO_MCP_CONTROLLER_SCOPE=virtual_only
ROBOTSTUDIO_MCP_TOKEN_FILE=C:\Users\User\AppData\Local\RobotStudioMCP\bridge-token
