{
  "solvers": [
    {
      "solver": "aedt",
      "template": true,
      "first_real_tool": "aedt_run_pyaedt_script_file",
      "required_env": ["AEDT_EXE", "PYAEDT_PYTHON"]
    },
    {
      "solver": "abaqus",
      "template": true,
      "first_real_tool": "abaqus_run_no_gui_script",
      "required_env": ["ABAQUS_COMMAND"]
    },
    {
      "solver": "fluent",
      "template": true,
      "first_real_tool": "fluent_run_journal_file",
      "required_env": ["FLUENT_EXE", "FLUENT_ROOT"]
    },
    {
      "solver": "ansys-workbench",
      "template": true,
      "first_real_tool": "ansys_run_workbench_journal_file",
      "required_env": ["WORKBENCH_EXE", "ANSYS_ROOT"]
    },
    {
      "solver": "ansys-mechanical",
      "template": true,
      "first_real_tool": "mechanical_run_workbench_journal_file",
      "required_env": ["WORKBENCH_EXE", "PYMECHANICAL_PYTHON"]
    },
    {
      "solver": "hypermesh",
      "template": true,
      "first_real_tool": "hypermesh_run_tcl_file",
      "required_env": ["HMBATCH_EXE"]
    },
    {
      "solver": "lammps",
      "template": true,
      "first_real_tool": "lammps_run_input_file",
      "required_env": ["LAMMPS_EXE"]
    },
    {
      "solver": "ovito",
      "template": true,
      "first_real_tool": "ovito_run_script_file",
      "required_env": ["OVITO_EXE", "OVITOS_EXE"]
    },
    {
      "solver": "comsol",
      "template": true,
      "first_real_tool": "comsol_compile_java_file",
      "required_env": ["COMSOL_ROOT", "COMSOL_BATCH", "COMSOL_COMPILE"]
    },
    {
      "solver": "matlab",
      "template": true,
      "first_real_tool": "matlab_run_script_file",
      "required_env": ["MATLAB_EXE", "MATLABROOT"]
    },
    {
      "solver": "openfoam",
      "template": true,
      "first_real_tool": "openfoam_run_case_command",
      "required_env": ["OPENFOAM_ROOT", "WM_PROJECT_DIR"]
    },
    {
      "solver": "paraview",
      "template": true,
      "first_real_tool": "paraview_run_pvpython_script",
      "required_env": ["PVPYTHON_EXE", "PARAVIEW_ROOT"]
    }
  ]
}
